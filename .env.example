# Copy to .env and adjust as needed. Read by relay/server.js.

# Address the relay HTTP/WebSocket server binds to.
# Use 127.0.0.1 when fronting the relay with a reverse proxy (see deploy/README.md);
# use 0.0.0.0 (the default) to listen on all interfaces for local LAN hosting.
BIND_HOST=0.0.0.0

# Port the relay listens on.
PORT=3000
