# Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Generated by the Unity editor, not source
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt

# Builds
*.apk
*.aab
*.app
*.unitypackage
*.exe

# Editors
.vs/
.vscode/
.idea/
*.DS_Store

# Verification harness output
verification-result.txt

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Per-machine relay override read by RelayClient. Pointing your own checkout at a
# local relay must not repoint everyone else's.
relay-url.txt

# Per-machine environment for the relay child, written by deploy/local-https.ps1.
relay-env.txt

# Per-machine network mode choice (LAN/Hotspot), written by StartScreen. Each host's
# own preference, not something one checkout should impose on everyone else's.
network-mode.txt

# Spike output. Records one machine's run, so it is evidence rather than source.
deploy/spike/*.log

# A backstop, not a workflow. local-https.ps1 keeps the borrowed local-ip.sh key in a
# scratch directory outside the repo precisely so this rule never has to fire — but
# .dockerignore is an allowlist, so a key that did land in relay/ would be baked into
# the Fly image, and that key is published.
*.pem
*.key
