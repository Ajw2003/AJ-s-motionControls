# /etc/systemd/system/rockskip-relay.service
#
# Runs the relay as an unprivileged user, restarts it if it dies, and starts it
# again on boot. Rooms are ephemeral and clients reconnect on their own, so a
# restart costs a few seconds of reconnection rather than any lost state.

[Unit]
Description=Rock Skipping relay
Documentation=https://github.com/Ajw2003/RockSkipping/blob/main/HostingPlan.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rockskip
Group=rockskip
WorkingDirectory=/opt/rockskip/relay
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

# The relay reads only its own directory and writes nothing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rockskip-relay

[Install]
WantedBy=multi-user.target
