# /etc/caddy/Caddyfile
#
# The entire TLS story. Caddy obtains a certificate for this name over ACME
# HTTP-01 on first start, renews it automatically, and reloads without dropping
# connections. There is no certbot, no cron entry, and no ACME code in the relay.
#
# reverse_proxy passes WebSocket upgrades through untouched, so the same block
# serves the controller page and carries wss:// traffic.
#
# The relay itself listens on 127.0.0.1:3000 and is not reachable from outside
# this machine — Caddy is the only thing bound to a public interface.

play.skiprocking.ca {
	reverse_proxy 127.0.0.1:3000

	log {
		output file /var/log/caddy/rockskip.log
		format console
	}
}
